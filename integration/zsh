# Shell integration for ebb terminal emulator.
# Compatible with eat's OSC 51 protocol.

__ebb_precmd () {
  __ebb_exit_status="$?"
  # Send exit status.
  if test -n "$__ebb_current_command"
  then
    printf '\e]51;e;H;%i\e\\' "$__ebb_exit_status"
  fi
  __ebb_current_command=""
  # Inform that a new prompt is going to be printed.
  printf '\e]51;e;J\e\\'
  # Send the current working directory, for directory tracking.
  printf '\e]51;e;A;%s;%s\e\\' "$(printf "%s" "$HOST" | base64)" \
         "$(printf "%s" "$PWD" | base64)"
  # Update title.
  printf '\e]2;%s@%s:%s%s\e\\' "$USER" "$HOST" "${PWD/$HOME/~}" \
         "$(test $UID -eq 0 && echo '#' || echo '%')"
}

__ebb_preexec () {
  __ebb_current_command="$1"
  # Send current command.
  printf '\e]51;e;F;%s\e\\' \
         "$(printf "%s" "$__ebb_current_command" | base64)"
  # Send pre-exec sequence.
  printf '\e]51;e;G\e\\'
  # Update title to include the command running.
  printf '\e]2;%s@%s:%s%s %s\e\\' "$USER" "$HOST" "${PWD/$HOME/~}" \
         "$(test $UID -eq 0 && echo '#' || echo '%')" \
         "$__ebb_current_command"
}

__ebb_wrap_prompts ()
{
  local __ebb_prompt_start="$(printf '\e]51;e;B\e\\')"
  local __ebb_prompt_end="$(printf '\e]51;e;C\e\\')"
  local __ebb_continuation_start="$(printf '\e]51;e;D\e\\')"
  local __ebb_continuation_end="$(printf '\e]51;e;E\e\\')"
  [[ "$PS1" == *"$__ebb_prompt_start"* ]] ||
    PS1="%{$__ebb_prompt_start%}$PS1%{$__ebb_prompt_end%}"
  [[ "$PS2" == *"$__ebb_continuation_start"* ]] ||
    PS2="%{$__ebb_continuation_start%}$PS2%{$__ebb_continuation_end%}"
}

__ebb_enable_integration ()
{
  __ebb_integration_enabled=yes
  __ebb_current_command=""
  __ebb_exit_status=0
  __ebb_wrap_prompts
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd __ebb_precmd
  add-zsh-hook preexec __ebb_preexec
}

_ebb_msg () {
  local msg=$'\e]51;e;M'
  for _ in $(eval "echo {1..$#}")
  do
    msg="$msg;$(printf "%s" "$1" | base64)"
    shift
  done
  printf "%s\e\\" "$msg"
}

# Enable.
if test -z "$__ebb_integration_enabled" && \
    { test "${TERM:0:6}" = "ebb-" || test "${TERM:0:4}" = "eat-"; }
then
  __ebb_enable_integration
elif test -n "$__ebb_integration_enabled"
then
  __ebb_wrap_prompts
fi

