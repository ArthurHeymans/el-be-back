# Shell integration for ebb terminal emulator.
# Compatible with eat's OSC 51 protocol.

# Only enable once and only in ebb/eat terminals.
if set -q __ebb_integration_enabled
    return 0
end
if not string match -q 'ebb-*' -- $TERM
    if not string match -q 'eat-*' -- $TERM
        return 0
    end
end

set -g __ebb_integration_enabled yes
set -g __ebb_current_command ""
set -g __ebb_exit_status 0

# We use fish's event system to emit OSC 51 sequences.
# The B (prompt start) and C (prompt end) sequences are emitted via
# fish_prompt/fish_right_prompt wrapper.  Since other tools (starship)
# may override fish_prompt AFTER us, we install the wrapper lazily
# on the first fish_prompt event.

function __ebb_install_prompt_wrapper --on-event fish_prompt
    # Remove ourselves - only need to run once
    functions -e __ebb_install_prompt_wrapper

    # Save whatever fish_prompt is now (after all config is loaded)
    if functions -q fish_prompt
        functions -c fish_prompt __ebb_original_fish_prompt
    else
        function __ebb_original_fish_prompt
            echo "> "
        end
    end

    # Replace fish_prompt with our wrapper
    function fish_prompt
        # Capture status FIRST before anything else runs
        set -l last_status $status
        set -l last_pipestatus $pipestatus

        # Send exit status of previous command
        if test -n "$__ebb_current_command"
            printf '\e]51;e;H;%d\e\\' $__ebb_exit_status
        end
        set -g __ebb_current_command ""

        # Before new prompt
        printf '\e]51;e;J\e\\'

        # Send CWD for directory tracking
        printf '\e]51;e;A;%s;%s\e\\' \
            (printf "%s" (hostname) | base64) \
            (printf "%s" $PWD | base64)

        # Update title
        printf '\e]2;%s@%s:%s\e\\' $USER (hostname) \
            (string replace -- $HOME '~' $PWD)

        # Prompt start marker
        printf '\e]51;e;B\e\\'

        # Restore status for the original prompt function
        # (starship and other prompts read $status)
        set -g __ebb_exit_status $last_status
        if set -q STARSHIP_CMD_STATUS
            set STARSHIP_CMD_STATUS $last_status
        end
        if set -q STARSHIP_CMD_PIPESTATUS
            set STARSHIP_CMD_PIPESTATUS $last_pipestatus
        end

        # Call original prompt
        __ebb_original_fish_prompt

        # Prompt end marker (after prompt text)
        printf '\e]51;e;C\e\\'
    end

    # Now call our new fish_prompt for the first time
    # (since we replaced it after the first event fired)
    # The prompt will be re-rendered by fish automatically.
end

function __ebb_preexec --on-event fish_preexec
    set -g __ebb_exit_status $status
    set -g __ebb_current_command $argv[1]
    # Send current command
    printf '\e]51;e;F;%s\e\\' \
        (printf "%s" $argv[1] | base64)
    # Send pre-exec sequence
    printf '\e]51;e;G\e\\'
    # Update title to include the command running
    printf '\e]2;%s@%s:%s %s\e\\' $USER (hostname) \
        (string replace -- $HOME '~' $PWD) \
        $argv[1]
end

function _ebb_msg
    set -l msg '\e]51;e;M'
    for arg in $argv
        set msg "$msg;"(printf "%s" $arg | base64)
    end
    printf "%s\e\\" $msg
end
